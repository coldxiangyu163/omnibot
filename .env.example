# OmniBot
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Agent
MAX_AGENT_ITERATIONS=10
MCP_CONFIG_PATH=omnibot.json

# RAG
CHROMA_PERSIST_DIR=./data/chroma

# Memory — "memory" (in-memory) or "sqlite" (persistent)
MEMORY_BACKEND=sqlite
SQLITE_PATH=./data/conversations.db
MEMORY_MAX_TURNS=50
MEMORY_TTL_SECONDS=86400

# Feishu (optional — leave empty to disable)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
